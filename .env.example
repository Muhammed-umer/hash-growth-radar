# TEMPLATE ONLY - never put real keys in this file, it is committed to git.
# Copy it to .env.local (same folder) and fill the real values there.
# .env.local is git-ignored.

# No login for now (a password gate can be added later in src/lib/auth.ts).
# Until then, keep the deployed URL private.

# --- Supabase (database) --------------------------------------------------
# supabase.com -> project -> Settings -> API. Both are read on the server only
# (no NEXT_PUBLIC_ prefix, so nothing is inlined into the browser bundle).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron protection --------------------------------------------------------
# Any random string of 16+ characters. Supabase Cron sends it as
# "Authorization: Bearer ..." (see supabase/migrations/0002_cron.sql).
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# --- AI (tagging only) ------------------------------------------------------
# gemini = free tier (default). anthropic = Claude (paid).
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# aistudio.google.com/apikey . Free tier: Google may use prompts to improve its products.
# Either one key:
GEMINI_API_KEY=
# ...or several, to spread the free per-minute limit. The app rotates through
# them and parks a key for a minute (an hour for a daily quota) when it is
# rate-limited, then uses the next one. Up to 8 are read: _1 .. _8.
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=

# Optional second provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- YouTube (automatic collector) ------------------------------------------
# console.cloud.google.com -> APIs & Services -> enable "YouTube Data API v3"
# -> Credentials -> API key.
# API restrictions: restrict the key to "YouTube Data API v3".
# Application restrictions: leave as None (the key is used from the server, and
# the host's outbound IPs are not fixed, so an IP or website restriction would
# break it). Keep the key secret instead; it never reaches the browser.
YOUTUBE_API_KEY=

# --- Reddit (automatic collector, later) ------------------------------------
# Only after Reddit approves your access request (README -> "Reddit access").
# Register the app at reddit.com/prefs/apps (type "script") to get the two codes.
# They return no data until the request is approved. Then also tick
# "Reddit API enabled" in the app's Settings page.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit wants a descriptive user agent, e.g. "web:hash-growth-radar:v0.1 (internal tool)"
REDDIT_USER_AGENT=
